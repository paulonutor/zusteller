{
  "name": "zusteller-tauri-host",
  "private": true,
  "version": "0.1.0",
  "description": "Thin Tauri v2 macOS host for the shared zusteller frontend. Holds only the Tauri CLI; the frontend has its own package.json.",
  "scripts": {
    "dev": "tauri dev",
    "dev:opaque": "tauri dev --config src-tauri/tauri.opaque.conf.json",
    "build": "tauri build",
    "build:opaque": "tauri build --config src-tauri/tauri.opaque.conf.json",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
