{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zusteller",
  "version": "0.1.0",
  "identifier": "de.onutor.zusteller",
  "build": {
    "devUrl": "http://localhost:47831",
    "frontendDist": "../../../frontend/dist",
    "beforeDevCommand": "npm --prefix ../../frontend run dev -- --port 47831 --strictPort",
    "beforeBuildCommand": "npm --prefix ../../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "zusteller",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "url": "index.html?vibrancy=1",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob: data:; base-uri 'none'; form-action 'none'; object-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
