{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the mail and Gmail activity windows. Event listening is needed for menus, accent updates and the connection action bridge.",
  "windows": [
    "main",
    "gmail-activity"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
